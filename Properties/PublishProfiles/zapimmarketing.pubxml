<?xml version="1.0" encoding="utf-8"?>
<!--
  Web Deploy profile for the zapimmarketing IIS site on 169.58.88.219 (same WMSVC endpoint as HRMS),
  published as the server's Administrator account. Visual Studio: Publish -> zapimmarketing -> enter its password.
  Run deploy\iis\setup-server.ps1 on the server once before the first publish (see deploy\iis\README.md).
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <MSDeployServiceURL>https://169.58.88.219:8172/msdeploy.axd</MSDeployServiceURL>
    <DeployIisAppPath>zapimmarketing</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>true</EnableMSDeployBackup>
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <AllowUntrustedCertificate>true</AllowUntrustedCertificate>
    <UserName>Administrator</UserName>
    <_SavePWD>false</_SavePWD>
  </PropertyGroup>
  <ItemGroup>
    <!-- server-only settings: connection string, admin bootstrap, AI key -->
    <MsDeploySkipRules Include="SkipProductionSettings">
      <ObjectName>filePath</ObjectName>
      <AbsolutePath>appsettings\.Production\.json</AbsolutePath>
    </MsDeploySkipRules>
    <MsDeploySkipRules Include="SkipLogsFolder">
      <ObjectName>dirPath</ObjectName>
      <AbsolutePath>logs</AbsolutePath>
    </MsDeploySkipRules>
  </ItemGroup>
</Project>
